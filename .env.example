# ============================================================
# AgentNet Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Required variables are marked with (required).
# Optional variables have defaults shown.

# --- Database ---
# Required. Services refuse to start in non-development environments if any
# secret is unset OR equal to the placeholder strings shipped in this file
# (e.g. "your_secure_password"). For dev, leave them as the placeholders —
# services fall back to a stable dev-only default that works inside the
# docker-compose stack.
POSTGRES_HOST=postgres                     # Docker service name
POSTGRES_PORT=5432
POSTGRES_USER=agentnet                     # (required)
POSTGRES_PASSWORD=your_secure_password     # (required) replace before deploy
POSTGRES_DB=agentnet
# Registry entrypoint: directory holding the init-db/*.sql bundle used to
# bootstrap an EMPTY database (defaults to /app/init-db inside the image;
# point it at <checkout>/services/registry/init-db when running the
# entrypoint from a local checkout). See docs/DATABASE_SCHEMA_CONTRACT.md.
# INIT_DB_DIR=/app/init-db

# --- Redis ---
REDIS_HOST=redis                           # Docker service name
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password         # (required) replace before deploy

# --- JWT Authentication ---
# Generate with:  openssl rand -hex 32
JWT_SECRET_KEY=your_jwt_secret_key         # (required) min 32 bytes in prod
JWT_ALGORITHM=HS256                        # Optional: HS256 (default)
JWT_EXPIRATION=3600                        # Optional: seconds (1 hour)

# --- Jaeger Tracing ---
JAEGER_ENABLED=true                        # Set "false" to disable trace EXPORT (spans still persist to the DB)
JAEGER_AGENT_HOST=jaeger                   # OTLP collector host (Jaeger all-in-one or any OTLP backend)
OTEL_EXPORTER_OTLP_PORT=4318               # OTLP/HTTP port; or set OTEL_EXPORTER_OTLP_ENDPOINT=https://... to override entirely
# JAEGER_AGENT_PORT (6831/UDP thrift) is no longer used: the thrift exporter is deprecated upstream

# --- Security ---
ENVIRONMENT=development                    # Set "production" / "staging" for non-dev
CORS_ALLOWED_ORIGINS=                      # (required in non-dev) Comma-separated allowlist
RATE_LIMIT_PER_MINUTE=60                   # Payment service global limit
RATE_LIMIT_USER_PER_MIN=100                # Registry per-user limit
RATE_LIMIT_USER_BURST=150
RATE_LIMIT_AGENT_PER_MIN=300               # Registry per-agent limit (higher)
RATE_LIMIT_AGENT_BURST=450

# --- Observability ---
LOG_LEVEL=INFO                             # DEBUG / INFO / WARNING / ERROR
WORKER_METRICS_PORT=9100                   # prometheus_client server in worker

# --- Sandbox ---
SANDBOX_TIMEOUT=30                         # Seconds before agent call is killed
SANDBOX_MAX_RESPONSE_SIZE=10485760         # 10 MB
SANDBOX_USE_GVISOR=false                   # Linux production only

# --- A2A Protocol ---
REGISTRY_PUBLIC_URL=http://localhost:8000

# --- Simulation Service ---
LLM_API_KEY=                               # OpenAI-compatible API key (optional)
LLM_BASE_URL=                              # Custom LLM endpoint (optional)
LLM_MODEL_NAME=gpt-4o-mini                 # Model name (optional)
ZEP_API_KEY=                               # Zep Cloud API key (optional)

# --- Self-improvement ---
# Phase 3.1: the worker's legacy reflection loop (REFLECTION_LOOP_*) and the
# AGENT_BACKLOG.md bridge are RETIRED. The Autonomous Society Runtime below is
# the only autonomous improvement control plane (docs/SOCIETY_RUNTIME.md).

# --- Legacy synthetic agents (legacy/synthetic-agents/*.py) — dev fixtures only ---
# Never started by compose, scripts or the runtime. The poll agent creates one
# task every 30s purely to fabricate activity (incompatible with Phase-3
# telemetry/anti-busywork); run it only against a throw-away local stack.
AGENT_PASSWORD=                            # legacy echo/poll agents' service account (required by them; never hard-code)

# --- Legacy Hermes scripts (legacy/hermes/*) — optional, only if you run them ---
# --- Email delivery (verification links) ------------------------------------
# disabled | log | smtp. Default: `log` in development, `disabled` everywhere
# else. `disabled` means registration REFUSES with 503 rather than creating an
# account whose verification link was never sent -- public human signup is
# blocked until a real provider is configured. `log` writes the link to the
# log and is refused in production.
EMAIL_DELIVERY_PROVIDER=
SMTP_HOST=                                  # required when EMAIL_DELIVERY_PROVIDER=smtp
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=                              # never commit a real value
SMTP_FROM=                                  # required when EMAIL_DELIVERY_PROVIDER=smtp
SMTP_STARTTLS=true                          # mutually exclusive with SMTP_TLS
SMTP_TLS=false                              # implicit TLS (usually port 465)
SMTP_TIMEOUT_SECONDS=15

AGENTNET_USER_EMAIL=
AGENTNET_USER_PASSWORD=
DEEPSEEK_API_KEY=                          # Never commit a real key. ROTATE any key that was ever committed to git history.
AGENTNET_ADMIN_EMAIL=                      # legacy/synthetic-agents/storyteller_agent.py stats login (optional)
AGENTNET_ADMIN_PASSWORD=
WEATHER_PASSWORD=                          # examples/weather_agent (optional)

# --- Autonomous Society Runtime v1 (services/registry/app/society) ---
# Everything dangerous is OFF by default. See docs/SOCIETY_RUNTIME.md.
SOCIETY_RUNTIME_ENABLED=false               # master switch for the society-worker loop
SOCIETY_MODEL_PROVIDER=scripted             # scripted (offline, deterministic) | openai_compatible | fake
SOCIETY_MODEL_NAME=                         # for openai_compatible (defaults to LLM_MODEL_NAME)
SOCIETY_MODEL_BASE_URL=                     # for openai_compatible, e.g. https://api.openai.com/v1 (defaults to LLM_BASE_URL)
SOCIETY_MODEL_API_KEY=                      # for openai_compatible (defaults to LLM_API_KEY). Never commit. Required only by the society worker (the model caller); the registry API mirrors the non-secret flags without it.
SOCIETY_MODEL_TIMEOUT_SECONDS=45
SOCIETY_MAX_RUNS_PER_HOUR=120               # global; per-agent limits live in agent_capability_grants
SOCIETY_DAILY_MODEL_BUDGET=2.0              # USD ceiling per day across the fleet
SOCIETY_MAX_CAUSATION_DEPTH=24              # loop breaker: max event chain depth (iterative engineering turns + promotion/fitness chain)
SOCIETY_MAX_RUNS_PER_CORRELATION=40         # loop breaker: max runs per story
SOCIETY_MAX_INTENTS_PER_RUN=5
SOCIETY_MAX_TASK_ESCROW_CREDITS=100         # cap on any single CREATE_TASK / CREATE_OFFER by the runtime
SOCIETY_RUN_LEASE_SECONDS=120
SOCIETY_RUN_MAX_ATTEMPTS=3
SOCIETY_EVENT_TTL_SECONDS=86400
SOCIETY_AUTONOMOUS_CODE_ENABLED=false       # Builder/QA/Security worktree loop (agentnet-auto/* branches, never merged)
SOCIETY_STAGING_DEPLOY_ENABLED=false        # REQUEST_STAGING_DEPLOY is recorded only; deployment stays a human/CI action
# SOCIETY_PRODUCTION_DEPLOY_ENABLED is intentionally NOT a setting: hard OFF in v1.
SOCIETY_REPO_ROOT=                          # git checkout the Builder creates worktrees from (default: this repo)
SOCIETY_WORKSPACE_ROOT=/tmp/agentnet-society-workspaces
SOCIETY_ROLES_FILE=                         # optional JSON overriding/extending roles (see roles.py)
SOCIETY_SYSTEM_USER_EMAIL=society-runtime@agentnet.local
SOCIETY_METRICS_PORT=9101                   # prometheus_client port for the society worker (0 = off)
SOCIETY_HEARTBEAT_INTERVAL_SECONDS=3600     # society.heartbeat cadence for the Governor (0 = off)
SOCIETY_INGEST_TASK_OUTCOMES=true           # turn platform task failures/timeouts into task.failed/task.timeout events
SOCIETY_INGEST_LOOKBACK_SECONDS=3600

# --- Society Phase 2: operators, approvals, ingress, live-model hardening ---
SOCIETY_OPERATOR_BOOTSTRAP_EMAILS=          # comma-separated; bootstrap the FIRST operator only, then assign durable roles via POST /v1/society/operators
SOCIETY_APPROVAL_RESUME_MAX_ATTEMPTS=3      # resume attempts for an approved intent before it is marked failed
SOCIETY_INGRESS_EVENT_ALLOWLIST=            # extra world event types allowed on POST /v1/society/events (defaults: platform.metric.anomaly, platform.health.degraded, user.feedback.received, staging.canary.signal)
SOCIETY_INGRESS_MAX_PAYLOAD_BYTES=8192
SOCIETY_INGRESS_MAX_PER_ACTOR_PER_HOUR=30
SOCIETY_INGRESS_MAX_PER_HOUR=120
SOCIETY_MODEL_REQUEST_RETRIES=1             # bounded model REQUEST retries (transport/429/5xx/timeout); distinct from run attempts
SOCIETY_MODEL_RETRY_BACKOFF_SECONDS=2
SOCIETY_MODEL_JSON_SCHEMA=false             # legacy alias of SOCIETY_MODEL_OUTPUT_FORMAT=json_schema
SOCIETY_MODEL_OUTPUT_FORMAT=auto            # auto (probe json_schema once, remember, fall back) | json_object (DeepSeek-documented) | json_schema
SOCIETY_MODEL_EMPTY_CONTENT_RETRIES=1       # bounded retry of the documented DeepSeek JSON-mode empty-content edge case
# ── Phase 4.1 (ADR-0007): provider request-capability profile + explicit reasoning policy ──
SOCIETY_MODEL_CAPABILITY_PROFILE=generic    # generic (plain OpenAI-compatible: never a `thinking` field) | deepseek (documented thinking toggle + reasoning_effort)
SOCIETY_MODEL_THINKING_MODE=auto            # auto (send nothing, provider default) | disabled | enabled — DeepSeek thinks by default; structured runs want `disabled`
SOCIETY_MODEL_REASONING_EFFORT=auto         # auto (send nothing) | none | low | medium | high | max — DeepSeek documents none|low|high|max; invalid values fail fast
# ── Phase 3: self-development (all fail closed; see docs/SELF_DEVELOPMENT.md) ──
SOCIETY_MODEL_FAST_NAME=                    # logical FAST tier -> provider model id (e.g. a future DeepSeek setup: deepseek-flash); defaults to SOCIETY_MODEL_NAME
SOCIETY_MODEL_STRONG_NAME=                  # logical STRONG tier (e.g. deepseek-v4-pro); empty = single tier, escalation fails closed to FAST
SOCIETY_MAX_CORRELATION_COST_USD=0.50       # model spend cap per story
SOCIETY_MAX_EXPERIMENT_COST_USD=0.25
SOCIETY_MAX_PROMOTION_COST_USD=0.25
SOCIETY_MAX_ENGINEERING_TURNS=6             # repo.read.result wakes per agent per correlation
SOCIETY_MAX_CORRELATION_ENGINEERING_TURNS=12
SOCIETY_MAX_REPO_READS_PER_RUN=5            # typed read intents per run (LIST_REPO_TREE/SEARCH_REPO/READ_REPO_*)
SOCIETY_MAX_REPO_READS_PER_CORRELATION=40
SOCIETY_MAX_REPO_BYTES_PER_RUN=120000
SOCIETY_MAX_SEARCH_RESULTS=40
SOCIETY_MAX_ENGINEERING_CORRELATION_DEPTH=20
SOCIETY_MAX_AUTONOMOUS_CANDIDATES_PER_DAY=10   # change budget (independent of model spend)
SOCIETY_MAX_RED_CANDIDATES_PER_DAY=2
SOCIETY_MAX_PROMOTIONS_PER_DAY=10
SOCIETY_MAX_OPEN_AUTONOMOUS_PRS=3
SOCIETY_MAX_FILES_PER_CANDIDATE=8
SOCIETY_MAX_DIFF_LINES=600
SOCIETY_PROMOTION_PROVIDER=disabled         # disabled (BLOCKED_EXTERNAL) | fake (shadow, tests/demo) | github (inert without repository + token)
SOCIETY_AUTO_MERGE_ENABLED=false            # GREEN-only autonomous merge; never AMBER/RED/CONSTITUTIONAL, never a draft PR, never under a merge freeze
SOCIETY_MAX_AUTONOMOUS_MERGES_PER_DAY=1     # merges the CONTROLLER performs per UTC day; 0 with auto-merge on is refused. No agent can raise it
SOCIETY_GITHUB_REPOSITORY=                  # owner/repo for the github provider (Promotion Controller only)
SOCIETY_GITHUB_BASE_BRANCH=main             # never a publish target
SOCIETY_GITHUB_API_URL=https://api.github.com
# GitHub credential boundary (Promotion Controller process ONLY; docs/GITHUB_PROMOTION.md):
SOCIETY_GITHUB_CREDENTIAL_PROVIDER=disabled # disabled (inert) | static (operator-supplied SOCIETY_GITHUB_TOKEN; tests/temporary) | app (GitHub App JWT -> short-lived installation token)
SOCIETY_GITHUB_APP_ID=                      # App ID or client ID (non-secret) for the app provider
SOCIETY_GITHUB_INSTALLATION_ID=             # installation ID (non-secret) for the app provider
SOCIETY_GITHUB_APP_PRIVATE_KEY_FILE=        # PATH to the platform-mounted PEM (never the key itself; never committed)
SOCIETY_GITHUB_TOKEN_REFRESH_MARGIN_SECONDS=300   # refresh an installation token this long before it expires
# SOCIETY_GITHUB_TOKEN (static provider) and SOCIETY_GITHUB_APP_PRIVATE_KEY_PEM (app provider, only when a file mount is
# impossible) are read ONLY inside services/registry/app/society/github_credentials.py. Never commit them; never give them
# to the cognition worker; they never appear in git argv/URLs, logs, events or model context.
SOCIETY_DEPLOYMENT_PROVIDER=disabled        # disabled (requests are BLOCKED_EXTERNAL) | fake (tests) — no hosting provider exists yet
SOCIETY_FITNESS_TEST_TIMEOUT_SECONDS=300
SOCIETY_PROMOTION_LEASE_SECONDS=300
SOCIETY_PROMOTION_MAX_ATTEMPTS=5
SOCIETY_PROMOTION_POLL_INTERVAL_SECONDS=60
# Runtime tuning knobs (defaults are fine; listed so the contract is complete — tests/test_config_parity.py)
# Response CAPACITY, not permission. SUBMIT_CODE_CANDIDATE carries whole file
# contents, and 1200 truncated a live Builder's JSON into a DEAD run.
SOCIETY_MODEL_MAX_OUTPUT_TOKENS=4000
SOCIETY_MODEL_USD_PER_1K_INPUT=0.0005       # cost accounting only; set to the provider's real price
SOCIETY_MODEL_USD_PER_1K_OUTPUT=0.0015
SOCIETY_REPEAT_MESSAGE_WINDOW_SECONDS=3600  # loop-storm protection: identical message suppression window
SOCIETY_RETRY_BACKOFF_BASE_SECONDS=5        # run retry backoff base (exponential)
SOCIETY_CIRCUIT_BREAKER_FAILURES=3          # consecutive failures before an agent is paused
SOCIETY_CIRCUIT_BREAKER_PAUSE_SECONDS=900
SOCIETY_WAKE_POLL_SECONDS=5                 # fallback poll when LISTEN society_wake is silent
SOCIETY_DISPATCH_BATCH_SIZE=50
SOCIETY_QA_TEST_TIMEOUT_SECONDS=300         # QA pytest subprocess timeout inside a candidate worktree
SOCIETY_BRANCH_PREFIX=agentnet-auto         # every candidate/promotion branch lives under this prefix
SOCIETY_WORKER_ID=                          # defaults to <hostname>-<pid>; set for stable lease ownership on a platform

# Phase 2 script inputs (NOT service settings; read by deploy/society-*.py and app.society.canary, never printed):
#   SOCIETY_SMOKE_TOKEN, SOCIETY_REDTEAM_TOKEN, SOCIETY_REDTEAM_USER_TOKEN, SOCIETY_REDTEAM_AGENT_TOKEN,
#   SOCIETY_CANARY_TOKEN, SOCIETY_CANARY_API_URL — see docs/SOCIETY_LIVE_MODEL_RUNBOOK.md §6.

# ── Phase 2.5 hosting-neutral additions ────────────────────────────
# Peers whose X-Forwarded-* headers uvicorn may trust (your platform's proxy
# IP/CIDR list, comma-separated). Default 127.0.0.1. Use '*' ONLY when the
# service port is reachable exclusively through that proxy.
FORWARDED_ALLOW_IPS=127.0.0.1
# Managed edge that documents X-Real-IP and publishes no ingress CIDR (Railway):
# "true" makes the registry take the client address from X-Real-IP only
# (ADR-0006 D5). X-Forwarded-For is never trusted this way. Enable ONLY where
# the port is reachable exclusively through that edge / a first-party mesh.
TRUST_X_REAL_IP=false
PUBLIC_BASE_URL=                            # absolute public origin (e.g. https://staging.example); links to humans are built from it; dev falls back to http://localhost:8000
ORCHESTRATOR_ENABLED=false
# Anonymous agent self-registration (POST /v1/agents/public-register); OFF = 404
PUBLIC_AGENT_REGISTRATION_ENABLED=false
# Builder auto-scaler (needs the Docker socket in the registry container); OFF by default
AUTO_SCALER_ENABLED=false                  # partner provisioning/OAuth API (registry); OFF unless a partner integration is live
INTERNAL_WORKER_TOKEN=                      # payment: shared secret the worker presents as X-Internal-Token (required outside development)
AGENT_LOGIN_MAX_SKEW_SECONDS=300            # signed agent logins must carry a timestamp within this window (replay protection)
# Auto-refund worker main-loop cadence in seconds (min 1; default 30)
WORKER_POLL_INTERVAL_SEC=30

# ── Service-to-service URLs and the dashboard (set by every compose file) ──
REGISTRY_URL=http://localhost:8000          # dashboard -> registry (the only backend the dashboard calls; API_BASE_URL is the legacy alias)
REGISTRY_API_URL=http://registry:8000       # worker -> registry (presence checks)
FLASK_SECRET_KEY=                           # dashboard session signing (required outside development): openssl rand -hex 32
BEHIND_PROXY=false                          # dashboard: "true" behind a reverse proxy / platform edge (trusts one X-Forwarded-* hop)

# ── Managed platform (Railway staging; docs/RAILWAY_STAGING.md) ──────────
# Exactly ONE deployment step owns the schema: the registry's pre-deploy
# command runs entrypoint.sh with SKIP_DB_BOOTSTRAP=false. Every other
# container built from the registry image (registry runtime, society worker)
# starts with SKIP_DB_BOOTSTRAP=true and never touches migrations. Local
# Compose leaves it unset (bootstrap + migrate at start, unchanged).
SKIP_DB_BOOTSTRAP=false
# society worker volume bootstrap (services/registry/start-society-railway.sh):
# public HTTPS clone URL WITHOUT credentials (a URL containing '@' is refused)
# and the trusted-base ref; the checkout is aligned to RAILWAY_GIT_COMMIT_SHA.
SOCIETY_REPO_URL=https://github.com/vansyson1308/agentnet.git
SOCIETY_REPO_REF=main

# ── Phase 8: A2A 1.0 gateway + federation (ADR-0009; docs/A2A_ARCHITECTURE.md) ──
# Every flag fails closed. With A2A_SERVER_ENABLED=false the gateway, streams,
# reconciler and Agent Cards all answer 404.
A2A_SERVER_ENABLED=false
A2A_PUBLIC_BASE_URL=                        # public https origin advertised in Agent Cards (e.g. https://api.agentnet.io.vn); never derived from request headers; required in production
A2A_FEDERATION_ENABLED=false                # remote card fetches, catalog writes, outbound A2A client
A2A_SOCIETY_CLIENT_ENABLED=false            # Society A2A intents (still grant-, policy- and approval-gated)
A2A_V03_COMPAT_ENABLED=false                # reserved: A2A 0.3 compatibility is NOT implemented; true is ignored and logged as an error
A2A_CREDENTIAL_KEY=                         # seals outbound connection credentials: a Fernet key or any secret >= 32 chars (a key is derived); on Railway a SHARED variable made once with ${{secret(64, "abcdef0123456789")}} and referenced by registry + society-worker. Never commit.
A2A_BLOCKING_WAIT_SECONDS=60                # bound for a blocking SendMessage (below Cloudflare's 100 s proxy timeout)
A2A_MAX_STREAMS_PER_PRINCIPAL=4
A2A_MAX_SUBSCRIBERS_PER_TASK=16
A2A_STREAM_MAX_SECONDS=900
A2A_MAX_REQUEST_BYTES=262144
A2A_MAX_FEDERATION_DEPTH=2                  # inbound delegation depth refused at or beyond this
A2A_RECONCILE_INTERVAL_SECONDS=2
A2A_DOCUMENTATION_URL=                      # optional https URL advertised as the card's documentationUrl
A2A_PROVIDER_URL=https://agentnet.io.vn     # provider.url in Agent Cards
A2A_FEDERATION_TEST_PRIVATE_HOSTS=          # LOCAL TESTS ONLY: hosts allowed to resolve to private addresses; ignored in production
# Society as an A2A client (ADR-0009 D14)
A2A_SOCIETY_DISCOVERY_ALLOWED_HOSTS=        # comma-separated hosts the Society may discover (empty = none)
A2A_SOCIETY_MAX_CALLS_PER_DAY=20            # external spend budget (Society-initiated outbound tasks per 24 h)
A2A_SOCIETY_MAX_CALLS_PER_CORRELATION=3     # agent-chain breaker
A2A_SOCIETY_BREAKER_FAILURES=3              # failed calls to one remote agent in an hour before new requests are refused
# Autonomous company mode (ADR-0009 D15; docs/AUTONOMOUS_COMPANY.md)
SOCIETY_COMPANY_CYCLE_ENABLED=false         # daily company.cycle event + portfolio caps
SOCIETY_COMPANY_CYCLE_HOUR_UTC=1            # the scheduled cycle starts at/after this UTC hour, once per date
SOCIETY_COMPANY_MAX_ACTIVE_HYPOTHESES=3     # Society hypotheses still being pursued while company mode is on
SOCIETY_COMPANY_HYPOTHESIS_SHELF_HOURS=72   # an APPROVED hypothesis untouched this long is shelved (no slot; >= 24)
SOCIETY_CANDIDATE_STALL_HOURS=24            # an open candidate without lifecycle progress this long: operator queue, no slot (never auto-abandoned)
SOCIETY_COMPANY_MAX_HIGH_RISK_INVESTIGATIONS=1   # open RED candidates before new code changes are refused
# Public-surface synthetic monitor (Society's eyes; docs/PUBLIC_SURFACE_CONTRACT.md).
# Deterministic anonymous HTTP against the PUBLIC product; no model per probe.
# Staging society-worker only: production refuses it (production has no Society).
SOCIETY_PUBLIC_SURFACE_MONITOR_ENABLED=false
SOCIETY_PUBLIC_SURFACE_MONITOR_INTERVAL_SECONDS=600   # >= 60
SOCIETY_PUBLIC_SURFACE_FAILURE_THRESHOLD=2            # consecutive failing checks before an event (>= 2)
SOCIETY_PUBLIC_SURFACE_COOLDOWN_SECONDS=21600         # one anomaly event per distinct failure set per window
SOCIETY_PUBLIC_SURFACE_MAX_EVENTS_PER_DAY=6           # hard cap on public.surface.anomaly events per UTC day
SOCIETY_PUBLIC_SURFACE_TIMEOUT_SECONDS=10             # per request
SOCIETY_PUBLIC_SURFACE_TARGET_LABEL=production        # label only (which public surface the origins name)
PUBLIC_PRODUCT_UI_ORIGIN=https://agentnet.io.vn       # bare https origin, no path
PUBLIC_PRODUCT_API_ORIGIN=https://api.agentnet.io.vn  # bare https origin, no path

# ============================================================
# Autonomous Maintenance OS (ADR-0010; docs/MAINTENANCE_OS.md)
# ============================================================
# Kernel (runs inside the staging society-worker). Everything that acts is OFF.
MAINTENANCE_AUTONOMY_ENABLED=false          # ONE owner master kill: false stops every new autonomous repair/release
MAINTENANCE_MONITORING_ENABLED=false        # trusted observations -> incidents + SLI samples
MAINTENANCE_COGNITION_ENABLED=false         # repair activities may call the (Society's) live model
MAINTENANCE_GREEN_PROMOTION_ENABLED=false   # a verified repair may be carried to main by the promotion controller
MAINTENANCE_GREEN_RELEASE_ENABLED=false     # MAINTENANCE_GREEN repairs may be released to production (release-control re-checks)
MAINTENANCE_TARGET=production               # which public environment the observations describe
MAINTENANCE_MAX_PLAN_REVISIONS=3            # immutable plan revisions per case (rescope bound)
MAINTENANCE_MAX_REPAIR_ATTEMPTS=4           # Builder attempts per case
MAINTENANCE_MAX_FILES=8                     # GREEN scope bound (more -> AMBER)
MAINTENANCE_MAX_CHANGED_LINES=400           # GREEN diff bound (more -> AMBER)
MAINTENANCE_CASE_MAX_HOURS=24               # wall clock before main; then SAFELY_ESCALATED
MAINTENANCE_MAX_CASE_COST_USD=0.50          # model spend per case (P0/P1: 2x)
MAINTENANCE_BUILDER_MAX_TURNS=10            # tool-loop turns per AuthorPatch try
MAINTENANCE_BUILDER_MAX_READ_CALLS=3        # read-tool calls per AuthorPatch try (live bench: 12 lost turns to reading; outlines + windows arrive first)
BENCH_BUDGET_USD=1                          # offline builder bench (scripts/bench, deploy/railway/bench_live.py): stop a run at this model spend
MAINTENANCE_MAX_TEST_RUNS_PER_ATTEMPT=8
MAINTENANCE_ACTIVITY_MAX_TRIES=3            # tries per activity before rescope/escalation
MAINTENANCE_ACTIVITY_TIMEOUT_SECONDS=180
MAINTENANCE_READ_PAGE_BYTES=12000           # one paged read (whole lines, explicit cursor)
MAINTENANCE_MAX_READ_BYTES_PER_ACTIVITY=120000
MAINTENANCE_MAX_ACTIVE_P0P1=1               # maintenance queue (never the innovation portfolio)
MAINTENANCE_MAX_ACTIVE_P2P3=2
MAINTENANCE_DAILY_MODEL_BUDGET_USD=1.00     # separate from SOCIETY_DAILY_MODEL_BUDGET
MAINTENANCE_P0P1_RESERVE_USD=0.40           # P2/P3 can never spend this part
MAINTENANCE_LEASE_SECONDS=900
MAINTENANCE_RECONCILE_BATCH=5
MAINTENANCE_STALL_SECONDS=900               # overdue without a lease -> CONTROL_PLANE incident
MAINTENANCE_RECOVERY_STREAK=3               # healthy observations before an incident is recovered
MAINTENANCE_CONFIRM_WINDOW_SECONDS=1800
MAINTENANCE_CASE_REOPEN_COOLDOWN_HOURS=24
MAINTENANCE_MAX_CASES_PER_INCIDENT=3
MAINTENANCE_MAX_AUTO_RELEASES_PER_DAY=1     # autonomous production maintenance releases per UTC day
MAINTENANCE_POST_DEPLOY_HEALTHY_OBSERVATIONS=3
MAINTENANCE_POST_DEPLOY_INTERVAL_SECONDS=60
# MAINTENANCE_ATTESTATION_KEY: HMAC key shared by the kernel (signs) and release-control (verifies).
#   Secret: set it in both services' environments, never here, never in a compose literal.
# Release Controller (separate `release-control` service: python -m app.maintenance.release_worker).
# It must NOT hold SOCIETY_MODEL_API_KEY / any Society GitHub credential (it refuses to start).
MAINTENANCE_RELEASE_PROVIDER=disabled       # disabled | live (fake is for tests)
MAINTENANCE_RELEASE_REPO=vansyson1308/agentnet
MAINTENANCE_RELEASE_MAIN_BRANCH=main
MAINTENANCE_RELEASE_PRODUCTION_BRANCH=production
MAINTENANCE_RELEASE_UI_ORIGIN=https://agentnet.io.vn
MAINTENANCE_RELEASE_API_ORIGIN=https://api.agentnet.io.vn
MAINTENANCE_RELEASE_OWNER_LOGINS=           # GitHub logins whose merge approves an AMBER release
MAINTENANCE_RELEASE_REQUIRE_SIGNATURE=true
MAINTENANCE_RELEASE_DEPLOY_GRACE_SECONDS=180   # wait for Railway's own Wait-for-CI deploy before triggering one
MAINTENANCE_RELEASE_BACKOFF_SECONDS=30
MAINTENANCE_RELEASE_MAX_TRANSIENT=20
MAINTENANCE_RELEASE_INTERVAL_SECONDS=30
MAINTENANCE_RAILWAY_PROJECT_ID=
MAINTENANCE_RAILWAY_ENVIRONMENT_ID=         # the PRODUCTION environment id
MAINTENANCE_RAILWAY_SERVICE_IDS={}          # JSON: {"registry": "...", "dashboard": "...", ...}
MAINTENANCE_RAILWAY_AUTH_MODE=project      # project (Project-Access-Token header) | account (Bearer)
MAINTENANCE_RELEASE_GITHUB_APP_ID=          # the dedicated Maintenance Release App (not the Society App)
MAINTENANCE_RELEASE_GITHUB_INSTALLATION_ID=
MAINTENANCE_RELEASE_GITHUB_PRIVATE_KEY_FILE=   # path to a mounted key FILE in release-control only
# MAINTENANCE_RAILWAY_TOKEN: production-scoped Railway token -- release-control ONLY. Secret: never here.
# Release preview (exact-SHA parity on an isolated NON-production environment; none = every release refuses)
MAINTENANCE_RELEASE_WORKER_MAX_CYCLES=0         # 0 = run until SIGTERM (a positive bound is for the boot smoke test only)
MAINTENANCE_RELEASE_PREVIEW=none            # none | staging_parity
MAINTENANCE_PREVIEW_RAILWAY_ENVIRONMENT_ID= # the preview environment (never the production one: refused)
MAINTENANCE_PREVIEW_RAILWAY_SERVICE_IDS={}  # JSON: {"registry": "...", "dashboard": "..."} in the preview environment
MAINTENANCE_PREVIEW_UI_ORIGIN=              # e.g. the staging dashboard origin
MAINTENANCE_PREVIEW_API_ORIGIN=             # e.g. the staging registry origin
MAINTENANCE_PREVIEW_RAILWAY_AUTH_MODE=project
# MAINTENANCE_PREVIEW_RAILWAY_TOKEN: a token scoped to the PREVIEW environment only -- release-control ONLY. Secret: never here.
# Deep-tier browser probe (scheduled job; deploy/maintenance/browser_probe.py)
MAINTENANCE_AXE_SOURCE=                     # path to the pinned axe-core build (axe-core@4.10.3 axe.min.js)
MAINTENANCE_INGEST_URL=                     # the kernel's registry, e.g. https://<staging registry>/v1/maintenance/observations/browser
MAINTENANCE_INGEST_EMAIL=                   # the event-producer account the scheduled probe logs in with (per run)
# MAINTENANCE_INGEST_PASSWORD: that account's password (GitHub repository secret). Secret: never here.
# MAINTENANCE_INGEST_TOKEN: an already-issued event-producer user JWT, manual one-off runs only (JWTs expire). Secret: never here.
