# ============================================================
# AgentNet Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Required variables are marked with (required).
# Optional variables have defaults shown.

# --- Database ---
# Required. Services refuse to start in non-development environments if any
# secret is unset OR equal to the placeholder strings shipped in this file
# (e.g. "your_secure_password"). For dev, leave them as the placeholders —
# services fall back to a stable dev-only default that works inside the
# docker-compose stack.
POSTGRES_HOST=postgres                     # Docker service name
POSTGRES_PORT=5432
POSTGRES_USER=agentnet                     # (required)
POSTGRES_PASSWORD=your_secure_password     # (required) replace before deploy
POSTGRES_DB=agentnet

# --- Redis ---
REDIS_HOST=redis                           # Docker service name
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password         # (required) replace before deploy

# --- JWT Authentication ---
# Generate with:  openssl rand -hex 32
JWT_SECRET_KEY=your_jwt_secret_key         # (required) min 32 bytes in prod
JWT_ALGORITHM=HS256                        # Optional: HS256 (default)
JWT_EXPIRATION=3600                        # Optional: seconds (1 hour)

# --- Jaeger Tracing ---
JAEGER_ENABLED=true                        # Set "false" to disable (no Jaeger dependency)
JAEGER_AGENT_HOST=jaeger                   # Docker service name
JAEGER_AGENT_PORT=6831

# --- Security ---
ENVIRONMENT=development                    # Set "production" for production
CORS_ALLOWED_ORIGINS=                      # (required in production) Comma-separated
RATE_LIMIT_PER_MINUTE=60

# --- Sandbox ---
SANDBOX_TIMEOUT=30                         # Seconds before agent call is killed
SANDBOX_MAX_RESPONSE_SIZE=10485760         # 10 MB
SANDBOX_USE_GVISOR=false                   # Linux production only

# --- A2A Protocol ---
REGISTRY_PUBLIC_URL=http://localhost:8000

# --- Simulation Service ---
LLM_API_KEY=                               # OpenAI-compatible API key (optional)
LLM_BASE_URL=                              # Custom LLM endpoint (optional)
LLM_MODEL_NAME=gpt-4o-mini                 # Model name (optional)
ZEP_API_KEY=                               # Zep Cloud API key (optional)

# --- Self-improvement loop (worker service) ---
# How often the worker scans for fresh failed/timeout/refunded tasks
# and auto-generates ImprovementProposal rows. Minimum effective
# value is 30s (anything lower is clamped to 30 to avoid hammering
# the DB on a 30s main-loop iteration).
REFLECTION_LOOP_INTERVAL_SEC=300
# How far back the loop looks for terminal-status tasks. Defaults to
# 24h so a fresh deploy doesn't backfill ancient failures into the lab.
REFLECTION_LOOP_LOOKBACK_HOURS=24
# Max proposals generated per pass (cap to keep batches small).
REFLECTION_LOOP_BATCH_LIMIT=50
