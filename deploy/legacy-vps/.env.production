# AgentNet Production Environment
# Copy to .env and fill in all values via `openssl rand -hex 32` /
# `openssl rand -base64 24`. Services refuse to start if any of these
# are missing or set to a known placeholder string.

# ── Database ─────────────────────────────────────────────────
POSTGRES_USER=agentnet
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32CHARS
POSTGRES_DB=agentnet

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_ANOTHER_STRONG_PASSWORD

# ── JWT ──────────────────────────────────────────────────────
# Generate via:  openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_AT_LEAST_64_CHARS_LONG_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Flask dashboard ──────────────────────────────────────────
# Generate via:  openssl rand -hex 32
FLASK_SECRET_KEY=CHANGE_ME_FLASK_SECRET_64_CHARS_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Security ─────────────────────────────────────────────────
ENVIRONMENT=production
BEHIND_PROXY=true
DOMAIN=agentnet.io.vn
CORS_ALLOWED_ORIGINS=https://agentnet.io.vn,https://www.agentnet.io.vn,https://dashboard.agentnet.io.vn,https://payment.agentnet.io.vn,https://staging.agentnet.io.vn

# Rate limit knobs (registry per-user / per-agent + payment global)
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_USER_PER_MIN=100
RATE_LIMIT_USER_BURST=150
RATE_LIMIT_AGENT_PER_MIN=300
RATE_LIMIT_AGENT_BURST=450

# ── Observability ────────────────────────────────────────────
JAEGER_ENABLED=false
LOG_LEVEL=INFO
WORKER_METRICS_PORT=9100

# ── Simulation (optional) ────────────────────────────────────
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_NAME=gpt-4o-mini
