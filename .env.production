# AgentNet Production Environment
# Copy to .env and fill in all values

# Database
POSTGRES_USER=agentnet
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32CHARS
POSTGRES_DB=agentnet

# Redis
REDIS_PASSWORD=CHANGE_ME_ANOTHER_STRONG_PASSWORD

# JWT
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_AT_LEAST_64_CHARS_LONG_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Security
ENVIRONMENT=production
CORS_ALLOWED_ORIGINS=https://app.agentnet.io,https://admin.agentnet.io,https://agentnet.io.vn,https://dashboard.agentnet.io.vn,https://payment.agentnet.io.vn
RATE_LIMIT_PER_MINUTE=60

# Tracing (disabled in production by default)
JAEGER_ENABLED=false

# Simulation (optional)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_NAME=gpt-4o-mini
